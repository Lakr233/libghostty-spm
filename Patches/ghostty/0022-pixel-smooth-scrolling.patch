+/// Smooth scrolling (a libghostty-spm patch). Scrolls the viewport by `up_px`
+/// pixels toward the scrollback (negative: toward the active area): whole
+/// rows move the viewport, the rest becomes `renderer_state.scroll_frac_px`,
+/// how far the grid is drawn above the viewport's first row. The fraction is
+/// always in [0, cell height) and is dropped (zero) where there is nothing
+/// to show past it: at the top of the scrollback and when the viewport
+/// reaches the active area. The renderer also ignores it once the viewport
+/// moves for any other reason (see `renderer.State.scroll_frac_offset`).
+///
+/// Precondition: the renderer_state mutex must be held.
+fn smoothScrollViewport(self: *Surface, up_px: f64) void {
+    const cell_h: f64 = @floatFromInt(self.size.cell.height);
+    if (cell_h <= 0) return;
+
+    const pages = &self.io.terminal.screens.active.pages;
+    const before = pages.scrollbar();
+    const frac: f64 = if (before.offset == self.renderer_state.scroll_frac_offset)
+        self.renderer_state.scroll_frac_px
+    else
+        0;
+
+    // Pixels from the top of the current first row down to the new top.
+    const target = frac - up_px;
+    const rows = @floor(target / cell_h);
+    var new_frac = target - rows * cell_h;
+    const delta: isize = @intFromFloat(rows);
+    if (delta != 0) self.io.terminal.scrollViewport(.{ .delta = delta });
+
+    const after = pages.scrollbar();
+    const moved = @as(isize, @intCast(after.offset)) - @as(isize, @intCast(before.offset));
+    if (moved != delta or after.offset + after.len >= after.total) new_frac = 0;
+
+    self.renderer_state.scroll_frac_px = @floatCast(new_frac);
+    self.renderer_state.scroll_frac_offset = after.offset;
+}
