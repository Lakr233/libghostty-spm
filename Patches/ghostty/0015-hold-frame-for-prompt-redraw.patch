+/// Clear one prompt row for a shell redraw. A row that had something on it
+/// leaves the screen waiting for that redraw; an empty one changes nothing
+/// the user can see, so there is nothing to hold a frame for.
+fn clearPromptCells(
+    self: *Screen,
+    page: *Page,
+    row: *Row,
+    cells: []Cell,
+) void {
+    for (cells) |cell| {
+        if (cell.isEmpty()) continue;
+        self.prompt_redraw_pending = true;
+        break;
+    }
+    self.clearCells(page, row, cells);
+}
