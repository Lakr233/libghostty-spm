index 498a8e488..dd29f3b9d 100644
--- a/src/termio/Termio.zig
+++ b/src/termio/Termio.zig
@@ -571,6 +571,23 @@ pub fn resetSynchronizedOutput(self: *Termio) void {
     self.renderer_wakeup.notify() catch {};
 }
 
+/// True when the last resize erased a prompt the shell has yet to redraw.
+pub fn promptRedrawPending(self: *Termio) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    return self.terminal.screens.active.prompt_redraw_pending;
+}
+
+/// Stop waiting for a shell to redraw its prompt. Called by timer expiration
+/// from the termio thread, for a shell that never does.
+pub fn resetPromptRedraw(self: *Termio) void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    var it = self.terminal.screens.all.iterator();
+    while (it.next()) |entry| entry.value.*.prompt_redraw_pending = false;
+    self.renderer_wakeup.notify() catch {};
+}
